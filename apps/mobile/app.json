{
  "expo": {
    "name": "GlucoGuide Patient",
    "slug": "glucoguide-patient",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "glucoguide",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0f5c5c"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GlucoGuide to find clinics near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GlucoGuide to use your photos for your profile picture and ID registration autofill."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow GlucoGuide to record your voice for booking and help chat.",
          "speechRecognitionPermission": "Allow GlucoGuide to convert speech to text for booking and Mira help."
        }
      ],
      "expo-audio",
      "expo-status-bar",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://docterpoint-backend-production.up.railway.app",
      "router": {},
      "eas": {
        "projectId": "d4129030-33ef-4cea-a0a0-17cebf857ce9"
      }
    },
    "ios": {
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow GlucoGuide to convert speech to text for booking and Mira help.",
        "NSMicrophoneUsageDescription": "Allow GlucoGuide to record your voice for booking and help chat."
      },
      "bundleIdentifier": "com.anonymous.glucoguide-patient"
    },
    "android": {
      "package": "com.glucoguide.patient",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    }
  }
}
