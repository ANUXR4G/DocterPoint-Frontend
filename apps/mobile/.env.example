# Simulator: localhost works with a local backend on :3001.
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Physical device + Expo tunnel: use a publicly reachable API (recommended).
EXPO_PUBLIC_API_URL=https://docterpoint-backend-production.up.railway.app

# Physical device + same Wi‑Fi (--lan): use your Mac LAN IP instead.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
