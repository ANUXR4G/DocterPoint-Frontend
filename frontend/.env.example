# Next.js web app (:3000) — API calls go through the Next proxy at /api/v1
NEXT_PUBLIC_API=http://localhost:3000/api/v1
NEXT_PUBLIC_URL=http://localhost:3000

# Direct GlucoGuide backend (used by Next API routes in app/api/v1/*)
BACKEND_URL=http://127.0.0.1:3001
NEXT_PUBLIC_WS_ORIGIN=localhost:3001
