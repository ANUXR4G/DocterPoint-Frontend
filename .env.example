# Database — GlucoGuide backend (canonical)
# Local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gluco_guide
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/gluco_guide
# Supabase (use pooler URL for DATABASE_URL — direct db.* is IPv6-only / flaky):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (backend/)
JWT_SECRET_KEY=replace-with-a-long-random-string
HASHING_SECRET_KEY=replace-with-32-byte-hex-or-passphrase
ACCESS_TOKEN_EXPIRES=120
REFRESH_TOKEN_EXPIRES=7

# App URLs — web :3000, GlucoGuide backend :3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_OG_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost

# Razorpay — subscription checkout (practice billing)
# Get test keys from https://dashboard.razorpay.com/app/keys
# Webhook URL: POST {API}/api/v1/procto/billing/razorpay-webhook
# After setting keys, run: cd backend && npm run razorpay:plans
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# S3 / MinIO (dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=glucoguide-uploads
S3_REGION=us-east-1

# WhatsApp (Meta Cloud API — leave blank to simulate sends)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Platform Meta display phone that owns WHATSAPP_PHONE_NUMBER_ID (boot pins this)
GLUCOGUIDE_OTP_PHONE=9990052082
# GLUCOGUIDE_OTP_PHONE_NUMBER_ID=  # defaults to WHATSAPP_PHONE_NUMBER_ID
# Local/Playwright only — never enable in production (returns Dev OTP in API JSON / web UI)
# QA_EXPOSE_OTP=1
# Optional default 6-digit Meta Cloud API two-step PIN (per-number PIN preferred)
WHATSAPP_TWO_STEP_PIN=
# Seed wipe is blocked on Supabase/non-local unless:
# ALLOW_PROD_SEED=1
# Embedded Signup — doctor clicks "Connect with Meta"; Phone Number ID returned automatically
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Optional: whatsapp_business_app_onboarding for WhatsApp Business app coexistence
META_EMBEDDED_SIGNUP_FEATURE=

# LLM — Mira chatbot + WhatsApp NLU use OPENAI_API_KEY only (gpt-4o-mini by default).
OPENAI_API_KEY=
# Optional chat model override (default gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional: vision model for ID OCR (default gpt-4o-mini). Use gpt-4o for higher accuracy.
# OPENAI_OCR_MODEL=gpt-4o-mini
# Optional Hugging Face for ID OCR / STT fallback only (not used by Mira chat).
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_CHAT_MODEL=Qwen/Qwen3.8-27B:featherless-ai
HF_OCR_MODEL=Qwen/Qwen3.5-9B:fastest
HF_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct:fastest
DEEPSEEK_API_KEY=
# Optional: bias WhatsApp voice STT (en | hi). Leave blank for auto-detect.
WHATSAPP_STT_LANGUAGE=
# Optional HF Whisper model when OPENAI_API_KEY is unset
WHATSAPP_STT_HF_MODEL=openai/whisper-large-v3

# Email/SMS fallback notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
OWNER_EMAIL=admin@glucoguide.com
