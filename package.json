{
  "name": "glucoguide-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/workers/emailWorker.ts",
    "worker:notifications": "tsx src/workers/notificationWorker.ts",
    "worker:all": "tsx src/workers/runAll.ts",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "npm run seed",
    "qa": "tsx scripts/qa-suite.ts",
    "qa:seed": "tsx scripts/qa-seed.ts",
    "qa:e2e": "tsx scripts/qa-e2e-flow.ts",
    "razorpay:plans": "tsx scripts/setup-razorpay-plans.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/client": "^6.3.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.13",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
